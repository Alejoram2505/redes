# LLM provider: openai or anthropic. Never commit a real key.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
# Optional OpenAI-compatible endpoint.
LLM_BASE_URL=https://api.openai.com/v1

# Remote Plant Energy MCP server.
PLANT_MCP_REMOTE_URL=http://127.0.0.1:8080/mcp
PLANT_MCP_AUTH_TOKEN=
PLANT_MCP_HOST=127.0.0.1
PORT=8080
PLANT_MCP_ALLOWED_ORIGINS=http://127.0.0.1,http://localhost
PLANT_MCP_MAX_BODY_BYTES=1048576
